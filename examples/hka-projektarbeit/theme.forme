theme "HKA Projektarbeit"
size 1920x1080

// Nachgebaut nach „praesentation_projektarbeit.pptx“: Roboto, weißer Grund, Karten mit
// lila Oberkante, vertikale HKA-Marke rechts, Kapiteltrenner „Teil X von Y“.

// ---------------------------------------------------------------- Farben
color primary #674EA7
color primary.dark #4C1D95
color ink #0F2E2E
color text #334155
color slate #475569
color muted #595959
color card #F8FAFC
color border #E2E8F0
color tint #EDE9FE
color tint.border #C4B5FD
color hka #E13800
color code.bg #F1F5F9

// ---------------------------------------------------------------- Maße
token margin 76
token gap 40
token content.y 232
token content.w 1680
token content.h 720

// ---------------------------------------------------------------- Schriften und Stile
// Schriftdateien (SIL Open Font License, siehe fonts/): exakte Textvermessung und Einbettung ins PDF
font heading "Roboto" weight=700 file="./fonts/roboto-latin-700-normal.woff"
font body "Roboto" weight=400 file="./fonts/roboto-latin-400-normal.woff"
font heading.italic "Roboto" weight=700 italic=true file="./fonts/roboto-latin-700-italic.woff"
font body.italic "Roboto" weight=400 italic=true file="./fonts/roboto-latin-400-italic.woff"
font mono "Courier New" weight=400

style title font=heading size=101 color=#000000 line=1.2 align=center
style subtitle font=body size=53 color=$text line=1.3 align=center
style context font=body size=48 color=$muted
style author font=body size=43 color=$muted italic=true
style h1 font=heading size=61 color=$ink line=1.2
style h2 font=heading size=40 color=$ink line=1.2
style section font=heading size=85 color=$ink line=1.2 align=center
style lead font=body size=43 color=$slate italic=true line=1.35 align=center
style body font=body size=35 color=$text line=1.35
style small font=body size=29 color=$text line=1.35
style quote font=body size=37 color=$ink italic=true line=1.4
style part font=heading size=29 color=$primary.dark align=center
style badge font=heading size=29 color=#FFFFFF fill=$primary radius=26 pad=14
style num font=heading size=35 color=#FFFFFF align=center valign=middle
style label font=body size=29 color=$muted italic=true
style footer font=body size=27 color=$muted
style code font=mono size=27 color=$ink line=1.4 fill=$code.bg radius=8 pad=24
style table font=body size=29 color=$text pad=18 border=$border header.fill=$primary header.color=#FFFFFF stripe=$card line=1.3

counter figure start=0
counter table start=0

// ---------------------------------------------------------------- Komponenten

// HKA-Wortmarke, horizontal und vertikal (Vektor, Farbe über color=)
component hka w=326 h=84 color=#E13800 {
  path @mark d="M0 99 L240 99 L240 133 L0 133 Z M101 0 L139 0 L139 230 L101 230 Z M258 0 L297 0 L297 230 L258 230 Z M375 0 L413 0 L413 89 L570 0 L570 44 L446 114 L575 189 L575 230 L413 135 L413 230 L375 230 Z M737 0 L780 0 L893 230 L845 230 L812 160 L697 160 L665 230 L618 230 Z M755 44 L716 125 L795 125 Z" w=param.w h=param.h fill=param.color
}

component hka_v w=96 h=252 color=#E13800 {
  path @mark d="M0 99 L240 99 L240 133 L0 133 Z M101 0 L139 0 L139 230 L101 230 Z M258 0 L297 0 L297 230 L258 230 Z M101 280 L139 280 L139 369 L296 280 L296 324 L172 394 L301 469 L301 510 L139 415 L139 510 L101 510 Z M130 560 L173 560 L286 790 L238 790 L205 720 L90 720 L58 790 L11 790 Z M148 604 L109 685 L188 685 Z" w=param.w h=param.h fill=param.color
}

// Karte mit lila Oberkante
component card w=520 h=400 title="Überschrift" body="Text" {
  rect @bg w=param.w h=param.h radius=12 fill=$card stroke=$border stroke.width=2
  rect @bar w=param.w h=10 radius=5 fill=$primary
  text @heading param.title style=h2 x=32 y=44 w=(param.w-64)
  text @text param.body style=body x=32 y=@heading.bottom+20 w=(param.w-64)
}

// Karte mit Nummernkreis
component ncard w=520 h=400 num="1" title="Überschrift" body="Text" {
  rect @bg w=param.w h=param.h radius=12 fill=$card stroke=$border stroke.width=2
  rect @bar w=param.w h=10 radius=5 fill=$primary
  ellipse @dot x=32 y=44 w=60 h=60 fill=$primary
  text @num param.num style=num x=32 y=44 w=60 h=60
  text @heading param.title style=h2 x=112 y=50 w=(param.w-144)
  text @text param.body style=body x=32 y=max(@dot.bottom,@heading.bottom)+28 w=(param.w-64)
}

// Hervorgehobene Frage oder Kernaussage mit Etikett
component callout w=1680 h=260 label="Leitfrage" body="Text" {
  rect @bg w=param.w h=param.h radius=16 fill=$tint stroke=$tint.border stroke.width=2
  text @label param.label style=badge x=40 y=28
  text @text param.body style=quote x=40 y=@label.bottom+20 w=(param.w-80)
}

// Kennzahl
component kpi w=520 h=240 value="0" label="Beschreibung" {
  rect @bg w=param.w h=param.h radius=12 fill=$card stroke=$border stroke.width=2
  rect @bar w=param.w h=10 radius=5 fill=$primary
  text @value param.value font=heading size=85 color=$primary x=32 y=40 w=(param.w-64)
  text @label param.label style=small x=32 y=@value.bottom+8 w=(param.w-64)
}

// Zeile einer nummerierten Übersicht
component step w=1680 h=72 num="1" title="Punkt" body="Beschreibung" {
  ellipse @dot y=6 w=60 h=60 fill=$primary
  text @num param.num style=num y=6 w=60 h=60
  text @heading param.title style=h2 x=88 y=12 w=620
  text @text param.body style=small x=740 y=16 w=(param.w-740)
}

// ---------------------------------------------------------------- Master

master plain {
  background fill=#FFFFFF
}

master default {
  background fill=#FFFFFF
  use @logo hka_v x=1800 y=724 w=96 h=252 color=$hka
  text @footsection "{section}" style=label x=$margin y=995
  text @pagenum "{slide.n}" style=footer x=1848 y=1005 anchor=center
}

// ---------------------------------------------------------------- Layouts

layout title master=plain {
  text @uni "**Hochschule Karlsruhe**\nUniversity of\nApplied Sciences" font=body size=25 line=1.15 color=$hka x=46 y=32
  use @logo hka x=350 y=36 w=326 h=84 color=$hka
  slot @context style=context x=1870 y=58 anchor=right placeholder="Art der Arbeit – Studiengang"
  slot @title style=title x=160 y=300 w=1600 placeholder="Titel der Arbeit"
  slot @subtitle style=subtitle x=260 y=@title.bottom+56 w=1400 placeholder="Untertitel"
  slot @author style=author x=50 y=968 placeholder="Vor- und Nachname"
}

layout content master=default {
  slot @title style=h1 x=$margin y=96 w=1700 placeholder="Folientitel"
  region content x=$margin y=$content.y w=$content.w h=$content.h
}

// Drei gleich breite Spalten für Karten
layout columns master=default {
  slot @title style=h1 x=$margin y=96 w=1700 placeholder="Folientitel"
  region content x=$margin y=$content.y w=$content.w h=$content.h
  region col1 x=$margin y=$content.y w=(($content.w-2*$gap)/3) h=$content.h
  region col2 x=(col1.right+$gap) y=$content.y w=col1.w h=$content.h
  region col3 x=(col2.right+$gap) y=$content.y w=col1.w h=$content.h
}

// Zwei Spalten, z. B. Bild links, Text rechts
layout split master=default {
  slot @title style=h1 x=$margin y=96 w=1700 placeholder="Folientitel"
  region content x=$margin y=$content.y w=$content.w h=$content.h
  region left x=$margin y=$content.y w=(($content.w-$gap)/2) h=$content.h
  region right x=(left.right+$gap) y=$content.y w=left.w h=$content.h
}

// Kapiteltrenner: „Teil 2 von 6“ wird aus den section-Zeilen des Decks berechnet
layout section master=default {
  text @part "Teil {section.n} von {deck.sections}" style=part fill=$tint radius=28 x=768 y=288 w=384 h=56 valign=middle
  slot @title style=section x=160 y=400 w=1600 placeholder="Kapitel"
  slot @subtitle style=lead x=200 y=@title.bottom+36 w=1520 placeholder="Worum es in diesem Teil geht"
}

layout closing master=default {
  hide @footsection
  slot @title style=section x=160 y=360 w=1600 placeholder="Vielen Dank – Fragen?"
  slot @body style=small align=center x=260 y=@title.bottom+48 w=1400 placeholder="Quellen, Links, Kontakt"
}

layout blank master=default
