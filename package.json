{
  "name": "forme",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --filter @forme/web dev",
    "build": "pnpm --filter @forme/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @forme/web test:e2e",
    "typecheck": "pnpm -r typecheck",
    "forme": "tsx packages/cli/src/main.ts",
    "preview": "pnpm --filter @forme/web preview",
    "build:docs": "pnpm --filter @forme/docs build",
    "docs": "pnpm --filter @forme/docs dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
