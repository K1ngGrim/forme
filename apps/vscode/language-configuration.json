{
  "comments": {
    "lineComment": "//"
  },
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "{",
      "close": "}"
    },
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "wordPattern": "[@$]?[A-Za-z_À-ɏ][\\w.À-ɏ-]*|#[0-9A-Fa-f]+|-?\\d+(?:\\.\\d+)?(?:px|%)?",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*\\}"
  }
}
